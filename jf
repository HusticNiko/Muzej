-- ===== VLC triple-screen auto-arranger =====
-- Requirements: grant Hammerspoon Accessibility permissions in System Settings.

local function sortScreensLeftToRight(screens)
  table.sort(screens, function(a, b)
    return a:frame().x < b:frame().x
  end)
  return screens
end

local function visibleStandardWindows(app)
  local wins = {}
  for _, w in ipairs(app:allWindows()) do
    if w:isStandard() and w:isVisible() then
      table.insert(wins, w)
    end
  end
  return wins
end

local function fullscreenSafe(win)
  -- Prefer macOS fullscreen; fallback to VLC's Cmd+F if needed.
  if win and win.setFullScreen then
    win:setFullScreen(true)
  end
  -- Some VLC builds ignore setFullScreen; send Cmd+F as fallback.
  if win then
    win:focus()
    hs.eventtap.keyStroke({"cmd"}, "f", 0)  -- VLC's fullscreen toggle
  end
end

local function arrangeVLCOnce()
  local vlc = hs.appfinder.appFromName("VLC")
  if not vlc then return false end

  local wins = visibleStandardWindows(vlc)
  local screens = sortScreensLeftToRight(hs.screen.allScreens())

  if #screens < 3 then
    hs.alert.show("Need at least 3 screens detected.")
    return true -- stop retrying; environment not ready
  end

  if #wins < 3 then
    return false -- not ready yet; keep retrying
  end

  -- Ensure deterministic order by sorting windows left->right before moving,
  -- so the same content stays on the same display across runs.
  table.sort(wins, function(a, b)
    return a:frame().x < b:frame().x
  end)

  -- Move each of the first three VLC windows to the three screens
  for i = 1, 3 do
    local win = wins[i]
    local scr = screens[i]
    if win and scr then
      -- Move and size to the target screen before fullscreen
      win:moveToScreen(scr)
      win:setFrame(scr:frame())
      fullscreenSafe(win)
    end
  end

  return true
end

-- Retry loop: wait for VLC to fully spawn its 3 windows.
local function arrangeVLCWithRetries()
  local attempts = 0
  local maxAttempts = 20  -- ~10 seconds total
  local timer = nil
  timer = hs.timer.doEvery(0.5, function()
    attempts = attempts + 1
    local done = arrangeVLCOnce()
    if done or attempts >= maxAttempts then
      if not done then
        hs.alert.show("VLC auto-arrange timed out.")
      end
      timer:stop()
    end
  end)
end

-- Auto-trigger when VLC launches or becomes active
local appWatcher = hs.application.watcher.new(function(name, event, app)
  if name == "VLC" and (event == hs.application.watcher.launched
                        or event == hs.application.watcher.activated) then
    -- Small delay so windows exist
    hs.timer.doAfter(1.0, arrangeVLCWithRetries)
  end
end)
appWatcher:start()

-- Optional: manual hotkey to rerun arrangement (Cmd+Alt+Ctrl+V)
hs.hotkey.bind({"cmd","alt","ctrl"}, "V", arrangeVLCWithRetries)


